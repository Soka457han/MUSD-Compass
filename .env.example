# ---- web (Vercel project 1, Root Directory = web) ----
MEZO_MAINNET_RPC=https://rpc-http.mezo.boar.network
MEZO_MAINNET_RPC_FALLBACK=https://mainnet.mezo.public.validationcloud.io
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
ETHEREUM_RPC=https://ethereum-rpc.publicnode.com
# optional: lets phone wallets connect (free id from Reown / WalletConnect)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# x402 payments go to the public dev wallet (SAMPLES.devWallet in code, so the button can check it)
X402_FACILITATOR_URL=https://facilitator.vativ.io
# Wallet that receives the mainnet payments (0.01 MUSD per call, Mezo mainnet). Leave empty and only the testnet price is offered.
# Use a wallet you control and treat as real money: the MUSD lands there. A malformed address is ignored, never advertised.
X402_MAINNET_PAY_TO=
# shared secret: the bot sends it as x-compass-bot so the API skips its per-IP limit
BOT_API_KEY=
# public bot link for the nav (defaults to https://t.me/musd_compass_bot)
NEXT_PUBLIC_BOT_URL=https://t.me/musd_compass_bot

# ---- bot (Vercel project 2, Root Directory = bot) ----
# The bot replies inside the webhook response, so it needs no bot token at runtime.
# Only letters, digits, _ and - (Telegram rule), 1-256 chars.
TELEGRAM_WEBHOOK_SECRET=
COMPASS_API_URL=https://musd-compass.vercel.app
COMPASS_WEB_URL=https://musd-compass.vercel.app
# BOT_API_KEY= (same value as above)

# Mezo mainnet writes on /vault (Savings Vault deposit/withdraw/claim, Borrow -> Earn, top-up, repay), capped at 2,500 MUSD per deposit and per new trove.
# Leave empty (off). Set to 1 first on a Preview deploy, try it with a small wallet, and only then on Production.
NEXT_PUBLIC_MAINNET_WRITES=
# Reown (WalletConnect) project id, used from Wave 2 for phone wallets. Free at cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
